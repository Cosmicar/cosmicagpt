rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userExists() {
      return isAuth()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists()
        && userData().rol == 'admin';
    }

    function isOperador() {
      return userExists()
        && userData().rol == 'operador';
    }

    function hasRole() {
      return isAdmin() || isOperador();
    }

    match /clientes/{docId} {
      allow read: if isAuth();
      allow create, update: if hasRole();
      allow delete: if isAdmin();
    }

    match /trabajos/{docId} {
      allow read: if isAuth();
      allow create, update: if hasRole();
      allow delete: if isAdmin();
    }

    match /usuarios/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.rol in ['admin', 'operador'];
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /config/ordenes {
      allow read: if isAuth();
      allow create, update: if hasRole();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
