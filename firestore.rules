rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de utilidad para leer el documento del perfil
    function getUserProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return getUserProfile().rol == 'admin';
    }

    function isOperador() {
      return getUserProfile().rol == 'operador';
    }
    
    function isStaff() {
      return isAdmin() || isOperador();
    }

    // 0. USUARIOS:
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && isAdmin();
    }

    // 1. TRABAJOS: Admin lee/escribe todo. Operador solo 'taller'.
    match /trabajos/{trabajoId} {
      // LECTURA: Admin lee todo. Operador solo lee los de 'taller'.
      allow read: if request.auth != null && (
        isAdmin() || 
        (isOperador() && resource.data.tipo == 'taller')
      );
      
      // CREACIÓN: Admin crea todo. Operador solo crea 'taller'.
      allow create: if request.auth != null && (
        isAdmin() || 
        (isOperador() && request.resource.data.tipo == 'taller')
      );

      // ACTUALIZACIÓN: Admin actualiza todo. Operador solo actualiza si el doc original y el nuevo son 'taller'.
      allow update: if request.auth != null && (
        isAdmin() || 
        (isOperador() && resource.data.tipo == 'taller' && request.resource.data.tipo == 'taller')
      );
      
      // BORRADO: Solo Admin.
      allow delete: if request.auth != null && isAdmin();
    }

    // 2. CLIENTES: Todo el staff (Admin y Operador) necesita crear/editar clientes al registrar una orden.
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null && isStaff();
    }

    // 3. ÓRDENES PÚBLICAS: Para la página de seguimiento.
    match /ordenesPublicas/{ordenId} {
      allow read: if true; 
      allow write: if request.auth != null && isStaff();
    }

    // 4. CONFIGURACIÓN (Ej. Contadores de orden):
    match /config/{configId} {
      allow read, write: if request.auth != null && isStaff();
    }
  }
}
