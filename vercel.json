{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node generar-provincias.js",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/index.html"
    },
    {
      "source": "/components/ui/:path*",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/components/ui/:path*"
    },
    {
      "source": "/components/ui/:path*",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/components/ui/:path*"
    },
    {
      "source": "/core/:path*",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/core/:path*"
    },
    {
      "source": "/core/:path*",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/core/:path*"
    },
    {
      "source": "/views/:path*",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/views/:path*"
    },
    {
      "source": "/views/:path*",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/views/:path*"
    },
    {
      "source": "/services/:path*",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/services/:path*"
    },
    {
      "source": "/services/:path*",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/services/:path*"
    },
    {
      "source": "/components/:path*",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/components/:path*"
    },
    {
      "source": "/components/:path*",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/components/:path*"
    },
    {
      "source": "/assets/:path*",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/assets/:path*"
    },
    {
      "source": "/assets/:path*",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/assets/:path*"
    },
    {
      "source": "/sw.js",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/sw.js"
    },
    {
      "source": "/sw.js",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/sw.js"
    },
    {
      "source": "/manifest.json",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "destination": "/apps/cosmica-app/manifest.json"
    },
    {
      "source": "/manifest.json",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "destination": "/apps/cosmica-app/manifest.json"
    }
  ],
  "redirects": [
    {
      "source": "/staff",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/staff/:path*",
      "destination": "https://app.cosmica.ar/:path*",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/apps/cosmica-app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "has": [{ "type": "host", "value": "app.cosmica.ar" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "has": [{ "type": "host", "value": "cosmicagpt.vercel.app" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
