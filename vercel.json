{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/validate-project-boundaries.mjs && node scripts/validate-marketing.mjs && node scripts/sync-brand-markup.mjs && node scripts/check-brand-official.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/cosmica-logo.webp",
      "destination": "/brand/v2/cosmica-isotipo-micro.svg"
    },
    {
      "source": "/cosmica-logo.png",
      "destination": "/brand/v2/cosmica-isotipo-micro.svg"
    },
    {
      "source": "/asistencia",
      "destination": "/asistencia.html"
    },
    {
      "source": "/soporte-tecnico-remoto-argentina",
      "destination": "/soporte-tecnico-remoto-argentina.html"
    },
    {
      "source": "/:page(pc-lenta-[a-z-]+)",
      "destination": "/:page.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "https://app.cosmica.ar/:path*",
      "permanent": true
    },
    {
      "source": "/staff",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/staff/:path*",
      "destination": "https://app.cosmica.ar/:path*",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/panel",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/panel.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/estado",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/estado.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    }
  ]
}
