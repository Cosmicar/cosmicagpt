{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/serviciotecnico",
      "destination": "/serviciotecnico.html"
    },
    {
      "source": "/planes",
      "destination": "/planes.html"
    },
    {
      "source": "/plus",
      "destination": "/plus.html"
    },
    {
      "source": "/asistencia",
      "destination": "/asistencia.html"
    },
    {
      "source": "/soporte-tecnico-remoto-argentina",
      "destination": "/soporte-tecnico-remoto-argentina.html"
    },
    {
      "source": "/:page(pc-lenta-[a-z-]+)",
      "destination": "/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/brand/official/icons/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "https://app.cosmica.ar/:path*",
      "permanent": true
    },
    {
      "source": "/staff.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/staff",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/staff/:path*",
      "destination": "https://app.cosmica.ar/:path*",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/panel",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/panel.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/estado",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    },
    {
      "source": "/estado.html",
      "destination": "https://app.cosmica.ar/",
      "permanent": true
    }
  ]
}
